.system_variable @sid_locked
@ifdef $OUTPUT

ALL_ARGS=$*

   @ifdef $1
   ACCESS_XXXXX_FILE=@files::.web_access_xxxxx

      @ifdef $ACCESS_XXXXX_FILE
      EXTRA=299999

      LENGTH=@strlen:$ALL_ARGS

         @if $LENGTH #> 44
         EXTRA=0
         @elif $LENGTH #> 16
         EXTRA=99999
         @elif $LENGTH #> 13
         EXTRA=199999
         @endif

      .=crypto_hash -x=$EXTRA "$ALL_ARGS"
      ALL_ARGS=$OUTPUT

      ~rm -f .web_access_xxxxx
      @endif
   @endif

.identity
COMBINED=@repstr:!/\n:$OUTPUT
IDENT=%COMBINED:1%

   @ifndef $CIYAM_QUIET
   #Locked Identity: $IDENT
   @endif

.session_variable @pubkey
EXT_PUBKEY=$OUTPUT

@:LOOP

@label NEXT

   ; NOTE: The password is an optional argument which is not recommended
   ; for typical usage (but is used by "release.sh" so that the password
   ; will only need to be entered a single time).
   @ifdef $1
   ARGS="$ALL_ARGS"
   @else
   DATA_AND_PUBKEY=@password:Enter unlock key, password or mnemonics to unlock the system identity:$EXT_PUBKEY
   ARGS=@repstr:\:/ -k=:$DATA_AND_PUBKEY
   @endif

.=identity $ARGS
COMBINED=@repstr:!/\n:$OUTPUT
NEW_IDENT=%COMBINED:1%

   @ifneq "$IDENT" "$NEW_IDENT"
      @ifndef $ERROR
         @ifndef $CIYAM_QUIET
         #Unlocked identity: $NEW_IDENT
         @endif
      @endif

   ~rm -f .unlock_failed

   @label DONE

   @else
   #Error: Unlock failed (incorrect key, password or mnemonics).

      @ifdef $1
      ~touch .unlock_failed
      Retry=
      @else
      &Retry? [yes=1|no=]
      @endif

      @ifndef $Retry
      @label DONE
      @endif

   @endif

@skip

@:NEXT

!!@:LOOP

@:DONE

@else

   @ifndef $1
      @ifndef $CIYAM_QUIET
      #(identity is not currently locked)
      @endif
   @else
      @ifndef $CIYAM_QUIET
      ~touch .unlock_skipped
      @endif
   @endif

@endif
