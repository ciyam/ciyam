@ifndef $CIYAM_PREFIXES
CIYAM_PREFIXES=1

PREFIX_LENGTH_DECODED=3
PREFIX_LENGTH_ENCODED=4

NORMAL_PREFIX_DECODED=_ $SP
PROMPT_PREFIX_DECODED=_?$SP
SYSTEM_PREFIX_DECODED=_:$SP
PRIVATE_PREFIX_DECODED=_!$SP
REACTION_PREFIX_DECODED=_#$SP
RESERVED_PREFIX_DECODED=_/$SP

NORMAL_PREFIX_ENCODED=XyAg
PROMPT_PREFIX_ENCODED=Xz8g
SYSTEM_PREFIX_ENCODED=Xzog
PRIVATE_PREFIX_ENCODED=XyEg
REACTION_PREFIX_ENCODED=XyMg
RESERVED_PREFIX_ENCODED=Xy8g

NORMAL_CRYPT_PREFIX_DECODED=_ X
PROMPT_CRYPT_PREFIX_DECODED=_?X
PRIVATE_CRYPT_PREFIX_DECODED=_!X

NORMAL_CRYPT_PREFIX_ENCODED=XyBY
PROMPT_CRYPT_PREFIX_ENCODED=Xz9Y
PRIVATE_CRYPT_PREFIX_ENCODED=XyFY

@endif
