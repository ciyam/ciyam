NUM_ARGS=0
@ifdef $1
NUM_ARGS=@$NUM_ARGS+1
@endif
@ifdef $2
NUM_ARGS=@$NUM_ARGS+1
@endif

@ifneq "$NUM_ARGS" "2"
ERROR=Need user and room number (and an optional join token).
@else

USERNAME=$1
IRC_ROOM=$2
EXTRA_TOKEN=$3

ROOM_PREFIX=_

UNJOIN=

FIRST=@substr:0,1:$IRC_ROOM
   @ifeq "$FIRST" "~"
   UNJOIN=1
   ROOM_PREFIX=
   @else

      @ifdef $EXTRA_TOKEN
      EXTRA_LEN=@strlen:$EXTRA_TOKEN
         @ifeq $EXTRA_LEN 8
         EXTRA_TOKEN=@strlit:#$EXTRA_TOKEN
         @else
         EXTRA_TOKEN=@strlit:-$EXTRA_TOKEN
         @endif
      @endif

   @endif

.run_script !irc_join "@name=$USERNAME,@room=$ROOM_PREFIX$IRC_ROOM$EXTRA_TOKEN"

   @ifndef $ERROR
   JOIN_LINES=@repstr:|/\n:$OUTPUT

   JOIN_LINE=@strlit:%JOIN_LINES:2%
   IRC_USERS=@strlit:%JOIN_LINES:4%

      @ifndef $IRC_USERS
      IRC_USERS=$JOIN_LINE
      @endif

   @endif

   @ifndef $UNJOIN
      @ifdef $IRC_USERS
      #$IRC_USERS
      @endif
   @endif

@endif
