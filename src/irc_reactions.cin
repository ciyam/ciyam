NUM_ARGS=0
@ifdef $1
NUM_ARGS=@$NUM_ARGS+1
@endif
;
@ifneq "$NUM_ARGS" "1"
ERROR=Encoded reactions are required for "irc_reactions".
@else
;
ENCODED=$1
IS_POLL=$2
;idk
trace_message "ENCODED is $ENCODED IS_POLL is '$IS_POLL'"
;
POLL_00=🇦
POLL_01=🇧
POLL_02=🇨
POLL_03=​​​🇩
POLL_04=​🇪
POLL_05=🇫
POLL_06=​​🇬
POLL_07=​🇭
POLL_08=​🇮
POLL_09=​​🇯
;
EMOJI_00=👌
EMOJI_01=👍
EMOJI_02=👎
EMOJI_03=🙂
EMOJI_04=🙁
EMOJI_05=😀
EMOJI_06=😲
EMOJI_07=🤓
EMOJI_08=🤦‍♂️
EMOJI_09=❤️
;
RLINES=@repstr:o/\n:$ENCODED
;
ALL_EMOJIS=
SHORT_LEN=6
;
@label RNEXT
;
@:RLOOP
NEXT_RLINE=%RLINES:1%
;
@ifndef $NEXT_RLINE
@label END_RLOOP
@endif
;
@skip
;
@:RNEXT
;
EMOJI=@substr:0,2:$NEXT_RLINE
;
SHORTS=@substr:2:$NEXT_RLINE
SHORTS=@repstr:x/:$SHORTS
;
SHORTS_LEN=@strlen:$SHORTS
NUM_USERS=@$SHORTS_LEN/$SHORT_LEN
;
@if $NUM_USERS #> 0
NUM_EXTRA=@$NUM_USERS-1
@ifeq $NUM_EXTRA 0
@ifdef $IS_POLL
NEXT_EMOJI=@strlit:$POLL_%EMOJI%($NUM_USERS)
@else
NEXT_EMOJI=@strlit:$EMOJI_%EMOJI%
@endif
@else
@ifdef $IS_POLL
NEXT_EMOJI=@strlit:$POLL_%EMOJI%($NUM_USERS)
@else
NEXT_EMOJI=@strlit:$EMOJI_%EMOJI%(+$NUM_EXTRA)
@endif
@endif
;
ALL_EMOJIS=@strlit:$ALL_EMOJIS$NEXT_EMOJI
@endif
;
RLINES=%RLINES:-1%
;
!!@:RLOOP
;
@:END_RLOOP
;
@endif
