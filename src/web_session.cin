NUM_ARGS=0
@ifdef $1
NUM_ARGS=@$NUM_ARGS+1
@endif
@ifdef $2
NUM_ARGS=@$NUM_ARGS+1
@endif
@ifdef $3
NUM_ARGS=@$NUM_ARGS+1
@endif
;
@ifneq "$NUM_ARGS" "3"
ERROR=Need token, device and session values.
@else
;
TOKEN=$1
DEVICE=$2
SESSION=$3
USERNAME=$4
;
ENTRANCE_ROOM=0000000
;
CIYAM_TMP_DIR=/tmp/ciyam
;
~mkdir -p $CIYAM_TMP_DIR/$SESSION
TEMP_FILE=$CIYAM_TMP_DIR/$SESSION/output.tmp
;
OUTPUT_FILE=$CIYAM_TMP_DIR/web.$TOKEN.$DEVICE
;
~rm -f $OUTPUT_FILE
;
LOCKED=
;
.system_variable @sid_locked
@ifdef $OUTPUT
EXTEND=@files::.web_extend_admin
@ifdef $EXTEND
LOCKED=-1
@else
EXTERN=@files::.web_extern_admin
@ifdef $EXTERN
LOCKED=-2
@else
LOCKED=-0
@endif
@endif
@endif
;
IRC_ROOM=$ENTRANCE_ROOM
;
IRC_ALLOWED=
;
; NOTE: If just started (or a reload has just taken place)
; then may need to wait for a second for the "auto script"
; session to have executed "irc_store_or_restore" (use the
; system variable "@no_irc" to skip if not using - it will
; will be cleared if "irc_store_or_restore" is later run).
.system_variable @no_irc
@ifndef $OUTPUT
.system_variable @auto_script
@ifdef $OUTPUT
IRC_ALLOWED=1
.system_variable @irc_allow
@ifndef $OUTPUT
.wait 200
.system_variable @irc_allow
@ifndef $OUTPUT
.wait 300
.system_variable @irc_allow
@ifndef $OUTPUT
.wait 500
.system_variable @irc_allow
@ifndef $OUTPUT
IRC_ALLOWED=
@endif
@endif
@endif
@endif
@endif
;
@endif
;
@ifdef $USERNAME
@ifdef $IRC_ALLOWED
@retain IRC_USERS
<web_session_join.cin "$USERNAME" "$IRC_ROOM"
@endif
@endif
;
@ifdef $IRC_ALLOWED
.variable @web.$TOKEN.$DEVICE.0*
@ifdef $OUTPUT
ALL_START_POINTS=$OUTPUT
ALL_START_POINTS=@repstr:@web.$TOKEN.$DEVICE./:$ALL_START_POINTS
ALL_START_POINTS=@repstr: /=:$ALL_START_POINTS
ALL_START_POINTS=@repstr:\n/,:$ALL_START_POINTS
;
session_variable @irc_start_points $ALL_START_POINTS
@endif
@endif
;
ADMIN_TOKEN=@file:.web_access_admin
;
@ifeq "$TOKEN" "$ADMIN_TOKEN"
.system_variable @web.$TOKEN.$DEVICE.message "[adm]$LOCKED"
@else
@ifdef $LOCKED
LOCKED=?
@endif
.system_variable @web.$TOKEN.$DEVICE.message "[std]$LOCKED"
@endif
;
.session_variable @storage_var_name @web.$TOKEN.$DEVICE.storage
;
@label NEXT
;
@:LOOP
;
@skip
;
@:NEXT
;
.wait -variable=@web.$TOKEN.$DEVICE.command -no_progress 60000 web_session
;
.system_variable @web.$TOKEN.$DEVICE.command
COMMAND=$OUTPUT
;
@ifndef $COMMAND
@label END_LOOP
@else
.system_variable @web.$TOKEN.$DEVICE.command ""
;
@ifneq "$COMMAND" ";@web_session_check"
; NOTE: Supports up to five commands.
>$TEMP_FILE
COMMAND_1=%COMMAND:1%
$COMMAND_1
@ifndef $ERROR
@ifdef "%COMMAND:2%"
COMMAND_2=%COMMAND:2%
$COMMAND_2
@endif
@ifndef $ERROR
@ifdef "%COMMAND:3%"
COMMAND_3=%COMMAND:3%
$COMMAND_3
@endif
@ifndef $ERROR
@ifdef "%COMMAND:4%"
COMMAND_4=%COMMAND:4%
$COMMAND_4
@endif
@ifndef $ERROR
@ifdef "%COMMAND:5%"
COMMAND_5=%COMMAND:5%
$COMMAND_5
@endif
@ifdef "%COMMAND:6%"
POS=@strpos:;:%COMMAND:6%
@ifneq "$POS" "0"
#IGNORED: %COMMAND:6%
@endif
@endif
@endif
@endif
@endif
@endif
>
; NOTE: As the command might take some time
; need to initially use a temporary file so
; the web session code will only detect the
; output file after completing the command.
~mv "$TEMP_FILE" "$OUTPUT_FILE"
;
ERROR=
;
@endif
@endif
;
.session_variable @script_executed
@ifeq "$OUTPUT" "irc_fetch_messages"
.session_variable @script_executed ""
;
@ifneq "$IRC_ROOM" "$ENTRANCE_ROOM"
.session_variable @irc_last_unique
UNIX_UNIQUE=$OUTPUT
;
@ifdef $UNIX_UNIQUE
.session_variable @irc_last_unique ""
;
UNIX_UNIQUE=@$UNIX_UNIQUE+1
.session_variable @irc_start_point_$IRC_ROOM $UNIX_UNIQUE
.session_variable @irc_start_prior_$IRC_ROOM $UNIX_UNIQUE
;
.system_variable @web.$TOKEN.$DEVICE.$IRC_ROOM
@ifneq "$OUTPUT" "$UNIX_UNIQUE"
.system_variable @irc_alter 1
.system_variable @web.$TOKEN.$DEVICE.$IRC_ROOM $UNIX_UNIQUE
@endif
@endif
@endif
;
@endif
;
.system_variable @web.$TOKEN.$DEVICE.session
;
@ifneq "$OUTPUT" "$SESSION"
ERROR=Session has been terminated.
@endif
;
@ifdef $ERROR
@label END_LOOP
@endif
;
!!@:LOOP
;
@:END_LOOP
;
~rm -rf $CIYAM_TMP_DIR/$SESSION
;
.system_variable @web.$TOKEN.$DEVICE.message ""
;
@endif
