 <groups/>
  <group/>
   <name>test_node
   <tests/>
    <test/>
     <name>1
     <description>Test Node.js usage of the CWS API.
     <test_step/>
      <name>*init*
      <exec>$$TESTS_DIR/test_node_init.sh
      <input>false
      <output>none
     </test_step>
     <test_step/>
      <name>a
      <exec>$$TESTS_DIR/test_node_1_a.sh
      <input>false
      <output>generate
     </test_step>
     <test_step/>
      <name>b
      <exec>$$TESTS_DIR/test_node_1_b.sh
      <input>false
      <output>generate
     </test_step>
     <test_step/>
      <name>*term*
      <exec>$$TESTS_DIR/test_node_term.sh
      <input>false
      <output>none
     </test_step>
    </test>
   </tests>
  </group>
 </groups>
</sio>
