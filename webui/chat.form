<!-- ================================================================
     Sign in
     ================================================================ -->
<div id="signin_view" class="chat-signin">
   <form id="signin_form" class="chat-signin-form" onsubmit="do_connect( ); return false;">
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">cws &middot; irc</span>
      </div>

      <h2 id="signin_title">Sign in</h2>
      <p class="chat-signin-lede" id="signin_lede">Credentials are hashed in this browser and never sent in the clear.</p>

      <label class="chat-label" for="signin_access">Account</label>
      <select id="signin_access" class="chat-field chat-field--mono" onchange="do_select_access( )">
         <option value="">Enter an account PIN&hellip;</option>
         <option value="create">+ Register new account</option>
      </select>

      <div id="signin_pin_row" hidden>
         <label class="chat-label" for="signin_pin">Account PIN</label>
         <input type="text" id="signin_pin" class="chat-field chat-field--mono" maxlength="12"
          placeholder="5 digits, or admin" autocomplete="off">
      </div>

      <div id="signin_name_row" hidden>
         <label class="chat-label" for="signin_name">Choose a username</label>
         <input type="text" id="signin_name" class="chat-field chat-field--mono" maxlength="12"
          placeholder="3-12 characters, lowercase" autocomplete="off">
         <div class="chat-hint" id="signin_name_hint">This is the name others see in chat.</div>
      </div>

      <div id="signin_password_row">
         <label class="chat-label" for="signin_password">Password</label>
         <input type="password" id="signin_password" class="chat-field chat-field--mono" autocomplete="current-password">
         <div class="chat-hint" id="signin_password_hint"></div>
      </div>

      <label class="chat-label" for="signin_retain">Remember on this browser</label>
      <select id="signin_retain" class="chat-field">
         <option value="none">Nothing &mdash; forget this account</option>
         <option value="access">The PIN only</option>
         <option value="full">The PIN and the password</option>
      </select>
      <div class="chat-hint">The PIN is the only way back into an account. Saving the
      password as well signs you in without typing it.</div>

      <div class="chat-signin-actions">
         <button type="submit" id="signin_connect" class="chat-btn chat-btn--primary">Connect</button>
      </div>

      <div id="signin_busy" class="chat-signin-busy" hidden>
         <span class="chat-spinner"></span>
         <span>Contacting the server&hellip;</span>
      </div>

      <div id="signin_error" class="chat-error-text" role="alert"></div>

      <!-- NOTE: This page is only seen with no session, so there is no connection state to
           show here - the device and session are in the account menu once signed in. -->
      <div class="chat-signin-foot">
         <button type="button" class="chat-btn--link" onclick="do_reset_browser( )">Reset this browser</button>
         <div class="chat-signin-foot-note">Forgets the device token and every saved account.</div>
      </div>
   </form>
</div>

<!-- ================================================================
     Chat
     ================================================================ -->
<div id="chat_view" class="chat-app" hidden>
   <div class="chat-topbar">
      <span class="chat-logo"></span>
      <span class="chat-wordmark">CIYAM</span>
      <span class="chat-divider"></span>
      <span class="chat-status">
         <span class="chat-dot"></span>
         Connected as <b id="topbar_user">&mdash;</b>
      </span>
      <div class="chat-topbar-right">
         <button type="button" class="chat-btn chat-btn--mono" id="console_toggle" onclick="do_toggle_console( )">Console</button>

         <!-- NOTE: The signed in user's initial, in place of an avatar image. It opens the
              account menu, which is where signing out now lives. -->
         <div class="chat-user">
            <button type="button" class="chat-avatar" id="user_avatar" aria-haspopup="menu" aria-expanded="false"
             aria-controls="user_menu" onclick="do_toggle_user_menu( )"></button>
            <div class="chat-user-menu" id="user_menu" role="menu" aria-labelledby="user_avatar" hidden>
               <div class="chat-user-menu-head">
                  <span class="chat-avatar chat-avatar--large" id="user_menu_initial" aria-hidden="true"></span>
                  <b class="chat-user-menu-name" id="user_menu_name"></b>
                  <!-- NOTE: "Session type" is Ian's term - "c_session_type_admin" and
                       "c_session_type_standard" in "ciyam.js". It belongs to the session: one
                       opened with the admin PIN is "[adm]", any other "[std]". -->
                  <dl class="chat-user-menu-facts">
                     <div><dt>PIN:</dt> <dd class="chat-mono" id="user_menu_pin"></dd></div>
                     <div><dt>Device:</dt> <dd class="chat-mono" id="user_menu_device"></dd></div>
                     <div><dt>Session type:</dt> <dd id="user_menu_type"></dd></div>
                     <div><dt>Session:</dt> <dd class="chat-mono" id="user_menu_session"></dd></div>
                  </dl>
                  <!-- NOTE: A linked tab takes over this session and polls on it too, which is
                       what ISS-020 is about - two senders on one session get each other's
                       responses. It is here for testing that, not for everyday use. -->
                  <button type="button" class="chat-user-menu-link" role="menuitem" onclick="do_menu_linked_tab( )"
                   title="Opens the chat in a new tab sharing this session - no second sign in">Open a linked tab &rarr;</button>
               </div>
               <button type="button" class="chat-user-menu-item" role="menuitem" onclick="do_menu_account_settings( )"
                title="Opens your account in a new tab sharing this session">Account settings&hellip;</button>
               <button type="button" class="chat-user-menu-item" role="menuitem" onclick="do_menu_sign_out( )">Sign out</button>
            </div>
         </div>
      </div>
   </div>

   <div id="chat_alert" class="chat-alert" hidden>
      <span class="chat-alert-text" id="chat_alert_text"></span>
      <button type="button" onclick="do_dismiss_alert( )" aria-label="Dismiss">&times;</button>
   </div>

   <div class="chat-body">
      <!-- room rail -->
      <nav class="chat-rail" id="room_rail" aria-label="Rooms">
         <div class="chat-rail-head">
            <!-- NOTE: The open rail covers the "<" that opened it, so it has its own, in the same
                 place - a second tap closes it. Shown only when the rail is a drawer. -->
            <button type="button" class="chat-head-btn chat-rail-close" onclick="close_drawers( true )"
             aria-label="Hide rooms" title="Close">
               <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
               </svg>
            </button>
            <span class="chat-section-label">Rooms</span>
            <button type="button" class="chat-btn chat-btn--small" onclick="do_open_create_room( )">+ New</button>
         </div>
         <!-- NOTE: Rooms, then direct messages - one scrolling area, so neither squeezes the other. -->
         <div class="chat-rail-lists">
            <div class="chat-room-list" id="room_list"></div>
            <!-- NOTE: Direct messages - a prototype. A conversation is a room named from its people;
                 see "dm_room_name( )" in "chat_parse.js". -->
            <div class="chat-rail-head chat-dm-head">
               <span class="chat-section-label">Direct messages</span>
               <button type="button" class="chat-btn chat-btn--small" onclick="do_open_new_message( )">+ New</button>
            </div>
            <div class="chat-room-list" id="dm_list"></div>
         </div>
         <!-- NOTE: When the rooms were last checked, and a way to check now. The icon is inline so
              the page still makes no outside request. -->
         <div class="chat-rail-foot">
            <div class="chat-rail-status">
               <span class="chat-busy" id="chat_busy" hidden title="Waiting for the server">
                  <span class="chat-spinner"></span>
               </span>
               <span class="chat-poll-label" id="rail_poll"></span>
            </div>
            <button type="button" class="chat-btn chat-refresh" id="rail_refresh" onclick="do_refresh( )"
             title="Check for new rooms and messages now">
               <svg class="chat-refresh-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M13.2 8A5.2 5.2 0 1 1 11.6 4.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M13.6 1.9v3.6H10z" fill="currentColor"/>
               </svg>
               Refresh
            </button>
         </div>
      </nav>

      <!-- thread -->
      <main class="chat-thread">
         <!-- NOTE: On a narrow screen the room rail and the room details slide away, and the two
              buttons here bring them back - each shows only while its panel is out of sight.
              "data-view" says what the thread is showing: a room has this bar at every width,
              an invitation or nothing at all only when a button is needed to get about. -->
         <div class="chat-thread-head" id="thread_head" data-view="room" hidden>
            <button type="button" class="chat-head-btn chat-rail-toggle" id="rail_toggle" aria-controls="room_rail"
             aria-expanded="false" aria-label="Show rooms" title="Rooms" onclick="do_toggle_rail( )">
               <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
                  <path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
               </svg>
               <span class="chat-head-badge" id="rail_badge" hidden></span>
            </button>
            <div class="chat-thread-title">
               <h1 id="thread_name">&mdash;</h1>
               <p class="chat-thread-sub" id="thread_sub" hidden></p>
            </div>
            <button type="button" class="chat-head-btn chat-details-toggle" id="details_toggle" aria-controls="room_details"
             aria-expanded="false" aria-label="Show room details" title="Room details" onclick="do_toggle_details( )">
               <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
                  <circle cx="3" cy="8" r="1.5" fill="currentColor"/>
                  <circle cx="8" cy="8" r="1.5" fill="currentColor"/>
                  <circle cx="13" cy="8" r="1.5" fill="currentColor"/>
               </svg>
            </button>
         </div>

         <!-- NOTE: Announcements - admin's messages in Administration, which only admin sees as
              a room - shown at the top of every room until dismissed. A prototype: see
              "pending_announcements( )" in "chat_parse.js". Not shown to admin. -->
         <section class="chat-announcements" id="announcements" aria-label="Announcements" hidden></section>

         <!-- Selected invitation - the server refuses a non-member's read, so nothing is
              fetched until the user joins. -->
         <div class="chat-empty chat-invite-view" id="thread_invite" hidden>
            <span class="chat-invite-eyebrow" id="invite_eyebrow">Invitation</span>
            <h2 id="invite_title"></h2>
            <p id="invite_text"></p>
            <div class="chat-invite-actions">
               <button type="button" class="chat-btn chat-btn--primary" id="invite_join" onclick="do_join_invitation( )">Join room</button>
               <button type="button" class="chat-btn" id="invite_decline" onclick="do_decline_invitation( )">Decline</button>
            </div>
            <p class="chat-invite-warning" id="invite_decline_note" hidden>Declining cannot be undone -
            the room cannot invite you again. Click Decline for good to confirm.</p>
         </div>

         <div class="chat-empty chat-loading" id="thread_loading" role="status" hidden>
            <span class="chat-spinner"></span>
            <p>Loading your rooms&hellip;</p>
         </div>

         <div class="chat-empty" id="thread_empty">
            <h2>No room selected</h2>
            <p>Pick a room from the rail, or create one. The entrance room is a lobby &mdash; it lists your rooms
            rather than holding a conversation.</p>
            <button type="button" class="chat-btn chat-btn--accent" onclick="do_open_create_room( )">Create a room</button>
         </div>

         <div class="chat-messages" id="message_list" hidden></div>

         <!-- NOTE: A new conversation's first messages, held until the others accept - a member
              sees nothing posted before they joined. In memory only. -->
         <div class="chat-held" id="held_list" hidden></div>

         <div class="chat-composer" id="composer" hidden>
            <!-- NOTE: The emoji panel - the device's own emoji font, from the curated list in
                 "chat_emoji.js". Opens above the message box; an emoji goes in at the cursor
                 and the panel stays open for more. -->
            <div class="chat-emoji-panel" id="emoji_panel" role="dialog" aria-label="Emoji" hidden>
               <input type="search" class="chat-field chat-emoji-search" id="emoji_search" placeholder="Search emoji"
                aria-label="Search emoji" autocomplete="off" spellcheck="false">
               <div class="chat-emoji-tabs" id="emoji_tabs"></div>
               <div class="chat-emoji-scroll" id="emoji_scroll"></div>
            </div>
            <!-- NOTE: For admin in Administration - what is being typed, as everyone else will see
                 it at the top of every room, and who will. -->
            <div class="chat-announcement-preview" id="announcement_preview" hidden>
               <div class="chat-announcement-preview-head">
                  <span class="chat-announcement-preview-label">Preview</span>
                  <span class="chat-announcement-preview-audience" id="announcement_preview_audience"></span>
               </div>
               <div id="announcement_preview_card"></div>
            </div>
            <!-- NOTE: The ":name" suggestions - typing ":thu" offers the matching emoji here. -->
            <ul class="chat-emoji-suggest" id="emoji_suggest" role="listbox" aria-label="Emoji suggestions" hidden></ul>
            <!-- NOTE: Shown only while what is typed is private - the words as well as the amber
                 of the box, so the mode is never shown by colour alone. Escape in an empty box
                 leaves it, as do each name's x and "Send to everyone". -->
            <div class="chat-composer-private" id="composer_private" title="Escape in an empty message box sends to everyone again" hidden>
               <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
                  <path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M2.5 13.5l11-11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
               </svg>
               <span class="chat-composer-private-label" id="composer_private_label">Private to</span>
               <div class="chat-recipients" id="recipient_row"></div>
            </div>
            <div class="chat-composer-row">
               <textarea id="composer_input" class="chat-input" rows="1"
                placeholder="Message" onkeydown="return do_composer_key( event )"
                aria-autocomplete="list" aria-controls="emoji_suggest" aria-expanded="false"></textarea>
               <button type="button" class="chat-btn chat-emoji-toggle" id="emoji_toggle" onclick="do_toggle_emoji( )"
                aria-label="Add an emoji" aria-haspopup="dialog" aria-expanded="false" aria-controls="emoji_panel"
                title="Emoji - Windows also has Win+. and macOS Ctrl+Cmd+Space">
                  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                     <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/>
                     <circle cx="7" cy="8" r="1.2" fill="currentColor"/>
                     <circle cx="13" cy="8" r="1.2" fill="currentColor"/>
                     <path d="M6.2 11.8c.9 1.5 2.2 2.3 3.8 2.3s2.9-.8 3.8-2.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
               </button>
               <button type="button" class="chat-btn chat-btn--primary" id="composer_send" onclick="do_send( )">Send</button>
            </div>
            <div class="chat-composer-foot">
               <button type="button" class="chat-btn chat-btn--small" id="composer_scope" onclick="do_toggle_scope( )">Send to selected&hellip;</button>
               <button type="button" class="chat-btn chat-btn--small" id="composer_cancel_edit" hidden onclick="do_cancel_edit( )">Cancel edit</button>
               <span class="chat-composer-note" id="composer_note">Ordinary chat only &mdash; system and slash messages are server-side.</span>
               <span class="chat-composer-count" id="composer_count" aria-live="polite" hidden></span>
            </div>
         </div>
      </main>

      <!-- NOTE: Dims the thread behind a panel slid over it; a tap on it closes the panel. -->
      <div class="chat-drawer-scrim" id="drawer_scrim" onclick="close_drawers( true )"></div>

      <!-- presence -->
      <aside class="chat-presence" id="room_details" aria-label="Room and members">
         <button type="button" class="chat-head-btn chat-drawer-close" onclick="close_drawers( true )"
          aria-label="Close room details" title="Close">&times;</button>
         <section class="chat-room-panel" id="room_panel" aria-label="Room details" hidden>
            <div class="chat-presence-head" id="room_panel_head">Room Details</div>
            <div class="chat-room-panel-name" id="room_fact_name"></div>
            <dl class="chat-room-facts">
               <div class="chat-room-fact"><dt>Number</dt><dd class="chat-mono" id="room_fact_number"></dd></div>
               <div class="chat-room-fact" id="room_fact_owner_row"><dt>Owner</dt><dd id="room_fact_owner"></dd></div>
               <!-- NOTE: The owner, or admin, can change who may post; everyone else sees it. -->
               <div class="chat-room-fact" id="room_fact_posts_row"><dt><label for="room_posts_select">Posting</label></dt><dd>
                  <span id="room_fact_posts"></span>
                  <select class="chat-room-posts" id="room_posts_select" onchange="do_change_posting( )" hidden>
                     <option value="any">Anyone</option>
                     <option value="own">Owner only</option>
                     <option value="none">Locked</option>
                  </select>
               </dd></div>
               <div class="chat-room-fact" id="room_fact_messages_row"><dt>Messages</dt><dd id="room_fact_messages"></dd></div>
               <div class="chat-room-fact" id="room_fact_inviter_row" hidden><dt>Invited by</dt><dd id="room_fact_inviter"></dd></div>
            </dl>
            <div class="chat-owner-actions" id="owner_actions" hidden>
               <button type="button" class="chat-btn chat-btn--small" onclick="do_open_rename_room( )">Rename</button>
               <button type="button" class="chat-btn chat-btn--small chat-btn--accent" id="owner_invite" onclick="do_open_invite( )">Invite</button>
            </div>
         </section>

         <div class="chat-presence-head" id="presence_head">Members</div>
         <div class="chat-member-list" id="member_list"></div>
         <div class="chat-presence-note">
            <code>+2</code> means two open sessions. <code>+0</code> is a member who is not connected.
         </div>
         <div class="chat-presence-foot" id="presence_foot">no push &middot; no typing state</div>
      </aside>
   </div>
</div>

<!-- ================================================================
     Console drawer - embeds the developer console and hands it the
     live session over BroadcastChannel.
     ================================================================ -->
<div id="console_drawer" class="chat-console" hidden>
   <div class="chat-console-bar">
      <span class="chat-console-label">Console</span>
      <span class="chat-console-session">
         <span class="chat-dot"></span>
         <span id="console_session">inherits chat session</span>
      </span>
      <button type="button" class="chat-console-close" onclick="do_popout_console( )" aria-label="Open the console in its own window" title="Open in its own window">&#8599;</button>
      <button type="button" class="chat-console-close" onclick="do_toggle_console( )" aria-label="Close console">&times;</button>
   </div>
   <div class="chat-console-notice" id="console_notice" hidden></div>
   <iframe id="console_frame" class="chat-console-frame" title="Developer console"></iframe>
</div>

<!-- ================================================================
     Dialogs
     ================================================================ -->
<div id="room_dialog" class="chat-scrim" hidden>
   <form class="chat-dialog" onsubmit="do_submit_room_dialog( ); return false;">
      <h2 id="room_dialog_title">Create a room</h2>
      <div id="room_dialog_name_row">
         <p class="chat-dialog-note" id="room_dialog_note">5 to 50 characters. Letters, digits, spaces and
         <span class="chat-mono">- + &amp; ( ) '</span> &mdash; one pair of brackets at most.</p>
         <label class="chat-label" for="room_dialog_name">Room name</label>
         <input type="text" id="room_dialog_name" class="chat-field" maxlength="50" autocomplete="off"
          oninput="do_clear_room_name_error( )" onblur="do_validate_room_name( )">
      </div>
      <div class="chat-error-text" id="room_dialog_error"></div>
      <div id="room_dialog_invitees_row" hidden>
         <label class="chat-label" for="room_dialog_invitees" id="room_dialog_invitees_label">Invite</label>
         <div class="chat-invitee-list" id="room_dialog_invitees"></div>
      </div>
      <div class="chat-dialog-actions">
         <button type="button" class="chat-btn" onclick="do_close_room_dialog( )">Cancel</button>
         <button type="submit" class="chat-btn chat-btn--accent" id="room_dialog_submit">Create</button>
      </div>
   </form>
</div>

<div id="pin_dialog" class="chat-scrim" hidden>
   <div class="chat-dialog">
      <h2>Account created</h2>
      <p class="chat-dialog-note">The server issued this PIN. <strong>It is the only way back
      into this account</strong> &mdash; it cannot be looked up later without an administrator,
      so write it down now.</p>
      <div class="chat-token" id="pin_value"></div>
      <div class="chat-hint" id="pin_username"></div>
      <div class="chat-dialog-actions">
         <button type="button" class="chat-btn" onclick="do_copy_pin( )">Copy PIN</button>
         <button type="button" class="chat-btn chat-btn--accent" onclick="do_close_pin_dialog( )">I have saved it</button>
      </div>
   </div>
</div>

<!-- ================================================================
     Templates

     NOTE: Cloned and filled with textContent - never innerHTML. Message
     text, usernames and room names all originate with other users.
     ================================================================ -->

<!-- NOTE: The rail shows the name, the unread count and any lock or invitation - the room's
     number and owner are in the Room section once it is selected. -->
<template id="tpl_room">
   <button type="button" class="chat-room">
      <span class="chat-room-top">
         <span class="chat-room-name"></span>
         <span class="chat-room-lock" hidden></span>
         <span class="chat-room-count"></span>
         <span class="chat-room-invite" hidden>Invitation</span>
      </span>
      <span class="chat-room-sub" hidden></span>
   </button>
</template>

<template id="tpl_day">
   <div class="chat-day">
      <span class="chat-day-label"></span>
   </div>
</template>

<template id="tpl_announcement">
   <div class="chat-announcement" role="note">
      <div class="chat-announcement-body">
         <div class="chat-announcement-head">
            <span class="chat-announcement-label">Announcement</span>
            <span class="chat-announcement-when"></span>
         </div>
         <p class="chat-announcement-text"></p>
      </div>
      <button type="button" class="chat-btn chat-btn--small chat-announcement-ok">OK</button>
   </div>
</template>

<template id="tpl_message">
   <div class="chat-message">
      <span class="chat-message-time"></span>
      <span class="chat-message-sender">
         <span class="chat-message-sender-name"></span>
         <span class="chat-edit-mark" hidden>*</span>
      </span>
      <span class="chat-message-text">
         <!-- NOTE: A crossed-out eye - "not everyone sees this". A lock already means a room's
              posting restriction in the rail. -->
         <span class="chat-private" hidden>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
               <path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
               <circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
               <path d="M2.5 13.5l11-11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <span class="chat-private-label"></span>
         </span>
         <span class="chat-message-body"></span>
         <span class="chat-edit-tag" hidden>edited</span>
         <button type="button" class="chat-message-edit" hidden>edit</button>
      </span>
   </div>
</template>

<template id="tpl_notice">
   <div class="chat-notice">
      <span class="chat-notice-text">
         <span class="chat-notice-time"></span>
         <span class="chat-notice-who"></span>
         <span class="chat-notice-verb"></span>
         <span class="chat-notice-detail"></span>
         <button type="button" class="chat-notice-action" hidden>Join</button>
      </span>
   </div>
</template>

<!-- NOTE: Clicking a member makes the next message private to them in this room; the envelope
     beside them opens a direct message instead. -->
<template id="tpl_member">
   <div class="chat-member-row">
      <button type="button" class="chat-member">
         <span class="chat-dot"></span>
         <span class="chat-member-name"></span>
         <span class="chat-member-count"></span>
      </button>
      <button type="button" class="chat-member-dm" title="Direct message">
         <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <rect x="2" y="3.5" width="12" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
            <path d="M2.6 4.4L8 8.6l5.4-4.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
         </svg>
      </button>
   </div>
</template>

<template id="tpl_recipient">
   <span class="chat-recipient">
      <span class="chat-recipient-name"></span>
      <button type="button" aria-label="Remove">&times;</button>
   </span>
</template>

<template id="tpl_invitee">
   <label class="chat-recipient">
      <input type="checkbox" class="chat-invitee-check">
      <span class="chat-invitee-name"></span>
   </label>
</template>
