<!-- NOTE: Before anyone signs in - how the node sees this connection, and its state. Shown above every
     arriving screen; "/system" decides both (Home App Scope, R1). -->
<div class="home-arrive-bar" id="arrive_bar" hidden>
   <span class="home-pill" id="security_pill" title="How the node sees this connection - from /system" hidden></span>
   <span class="home-pill" id="state_pill" hidden></span>
</div>

<!-- NOTE: The shared sign in ("signin.js") is built here. -->
<div id="signin_host"></div>

<div class="chat-signin" id="checking_view">
   <div class="chat-signin-form">
      <p class="chat-signin-lede" role="status">Looking for the node&hellip;</p>
   </div>
</div>

<div class="chat-signin" id="unreachable_view" hidden>
   <div class="chat-signin-form">
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">home</span>
      </div>

      <h2 tabindex="-1">The node did not answer</h2>
      <p class="chat-signin-lede">This address did not answer as a CIYAM node. It may be starting up, or the
       connection may be down.</p>

      <div class="chat-signin-actions">
         <button type="button" class="chat-btn chat-btn--primary" id="unreachable_retry">Try again</button>
      </div>
   </div>
</div>

<div class="chat-signin" id="setup_view" hidden>
   <div class="chat-signin-form">
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">home</span>
      </div>

      <h2 tabindex="-1">This node needs setting up</h2>
      <p class="chat-signin-lede">It has no identity yet, so nobody can sign in. Setting it up gives it:</p>

      <ul class="home-list">
         <li>twelve words that can restore it - written down and kept safe</li>
         <li>a master password, for unlocking it after a restart</li>
         <li>admin's PIN, to sign in and add people</li>
      </ul>

      <p class="home-note">For now this is done on the node itself, from its terminal - see "docs/system_identity.md".
       Setting up from here is planned.</p>

      <div class="chat-signin-actions">
         <button type="button" class="chat-btn" id="setup_retry">Check again</button>
      </div>
   </div>
</div>

<!-- NOTE: Unlocking needs a session - the unlock key is used on one ("employ_unlock_key( )") - so a locked
     node is signed in to first, then unlocked. Anyone with a key may unlock, not only admin (Ian, 2026-10-03). -->
<div class="chat-signin" id="unlock_view" hidden>
   <div class="home-unlock">
      <form class="chat-signin-form" id="unlock_form" novalidate>
         <div class="chat-brand">
            <span class="chat-logo"></span>
            <span class="chat-wordmark">CIYAM</span>
            <span class="chat-brand-note">home</span>
         </div>

         <h2 tabindex="-1">This node is locked</h2>
         <p class="chat-signin-lede">It restarted, and the apps cannot be used until it is unlocked. Use one of the
          unlock keys you kept.</p>

         <label class="chat-label" for="unlock_key">Unlock key</label>
         <input type="text" id="unlock_key" class="chat-field chat-field--mono" placeholder="XXXXX-xxxxx-XXXXX"
          autocomplete="off" autocapitalize="off" spellcheck="false">
         <div class="signin-hint">Each key works once. Make a new one afterwards, in Unlock keys.</div>

         <div class="chat-error-text" id="unlock_error" role="alert"></div>
         <div class="home-done-text" id="unlock_done" role="status"></div>

         <div class="chat-signin-actions">
            <button type="submit" class="chat-btn chat-btn--primary" id="unlock_submit">Unlock</button>
            <button type="button" class="chat-btn" id="unlock_sign_out">Sign out</button>
         </div>
      </form>

      <!-- NOTE: The master password is a rescue - for someone on the node's own network with no keys left
           (Ian, 2026-10-03). Over a connection the node sees as unencrypted that is said before it is typed. -->
      <details class="home-rescue" id="rescue_panel">
         <summary>No keys left? Use the master password</summary>

         <form id="rescue_form" novalidate>
            <p class="home-note">The master password unlocks the node like a key, but it is the node's most important
             secret. Only type it on a device on the node's own network - never from outside.</p>

            <div class="home-warning" id="rescue_warning" role="alert" hidden>
               <strong>This connection isn't encrypted.</strong> The node sees it as plain text - only use the password
               if you are on the node's own network.
            </div>

            <label class="chat-label" for="rescue_password">Master password</label>
            <input type="password" id="rescue_password" class="chat-field" autocomplete="off">

            <div class="chat-error-text" id="rescue_error" role="alert"></div>

            <div class="chat-signin-actions">
               <button type="submit" class="chat-btn" id="rescue_submit">Unlock with the password</button>
            </div>
         </form>
      </details>

      <p class="home-note home-unlock-foot">After a restart, chat rooms held only in memory may be gone until the node
       restores them.</p>
   </div>
</div>

<!-- NOTE: Signed in, the node ready - the shell (build step 4): a side menu of apps and, for admin, the node's
     sections, with who is signed in and "Sign out of every app". On a phone the menu is a drawer from the top
     bar, admin's sections are chips beneath it, and the apps are a bar along the bottom. The apps other than
     Home open in their own tabs on this session. The rail's items are built by "home.js". -->
<div class="home-app" id="app_view" hidden>
   <nav class="home-rail" id="home_rail" aria-label="Home">
      <div class="home-rail-brand">
         <span class="chat-logo"></span>
         <span class="home-rail-brand-text">
            <span class="chat-wordmark">CIYAM</span>
            <span class="home-rail-brand-note">Home node</span>
         </span>
      </div>

      <div class="home-rail-group">
         <span class="home-rail-heading">Apps</span>
         <div id="rail_apps"></div>
      </div>

      <div class="home-rail-group" id="rail_node" hidden>
         <span class="home-rail-heading">Node</span>
         <div id="rail_sections"></div>
      </div>

      <div class="home-rail-spacer"></div>

      <div class="home-rail-user">
         <div class="home-rail-user-row">
            <span class="home-avatar" id="rail_avatar"></span>
            <span class="home-rail-user-text">
               <span class="home-rail-user-name" id="rail_name"></span>
               <span class="home-rail-user-role" id="rail_role"></span>
               <span class="home-rail-user-role">PIN <span class="home-mono" id="rail_pin"></span></span>
            </span>
         </div>
         <button type="button" class="chat-btn" id="app_sign_out">Sign out of every app</button>
      </div>
   </nav>

   <div class="home-scrim" id="rail_scrim" hidden></div>

   <div class="home-body">
      <header class="home-topbar">
         <button type="button" class="home-menu-button" id="rail_open" aria-label="Open the menu" aria-controls="home_rail"
          aria-expanded="false">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
         </button>

         <span class="home-topbar-title">
            <span class="home-topbar-heading" id="top_heading"></span>
            <span class="home-topbar-sub" id="top_sub"></span>
         </span>

         <span class="home-pill" id="app_security_pill" title="How the node sees this connection - from /system" hidden></span>

         <span class="home-avatar home-topbar-avatar" id="top_avatar"></span>
      </header>

      <nav class="home-chips" id="home_chips" aria-label="Node" hidden></nav>

      <main class="home-main">
         <!-- NOTE: A member's Home (build step 5) - their apps, what needs them, announcements and their account.
              What it says of the chat is read as the chat reads it ("chat_parse.js"). -->
         <section class="home-section" id="section_home" hidden>
            <h1 id="app_greeting"></h1>
            <p class="home-note" id="app_node"></p>

            <div class="home-tiles" aria-label="Your apps">
               <a class="home-tile" href="#" id="tile_chat">
                  <span class="home-tile-top">
                     <span class="home-tile-icon is-chat" id="tile_chat_icon"></span>
                     <span class="home-tile-tab">Opens in its own tab</span>
                  </span>
                  <span class="home-tile-title">Chat</span>
                  <span class="home-tile-text" id="tile_chat_text">&hellip;</span>
               </a>
               <a class="home-tile" href="#" id="tile_account">
                  <span class="home-tile-top">
                     <span class="home-tile-icon is-account" id="tile_account_icon"></span>
                     <span class="home-tile-tab">Opens in its own tab</span>
                  </span>
                  <span class="home-tile-title">My account</span>
                  <span class="home-tile-text">Password and devices</span>
               </a>
            </div>

            <div class="home-columns">
               <div class="home-column-main">
                  <section class="home-card" aria-labelledby="needs_heading">
                     <div class="home-card-head">
                        <h2 id="needs_heading">Needs you</h2>
                        <span class="home-count" id="needs_count" hidden></span>
                     </div>
                     <ul class="home-needs" id="needs_list"></ul>
                     <p class="home-note home-empty" id="needs_empty">Nothing is waiting for you.</p>
                  </section>

                  <div id="announce_list"></div>
               </div>

               <section class="home-card home-column-side" aria-labelledby="account_heading">
                  <h2 id="account_heading">Your account</h2>
                  <div class="home-rail-user-row">
                     <span class="home-avatar home-avatar--large" id="account_avatar"></span>
                     <span class="home-rail-user-text">
                        <span class="home-rail-user-name" id="account_name"></span>
                        <span class="home-rail-user-role"><span id="account_role"></span> &middot; PIN
                         <span class="home-mono" id="account_pin"></span></span>
                     </span>
                  </div>
                  <div class="home-devices">
                     <span class="home-rail-heading">Devices</span>
                     <ul class="home-device-list" id="device_list"></ul>
                     <a href="#" id="manage_devices">Manage devices in My account</a>
                  </div>
               </section>
            </div>
         </section>

         <!-- NOTE: Admin's sections (build step 6) - what the web API gives today. Sessions in use and the other
              limits wait on Ian's combined admin request (R2). -->
         <section class="home-section" id="section_overview" hidden>
            <div class="home-section-head">
               <span>
                  <h1>Overview</h1>
                  <p class="home-note" id="overview_node"></p>
               </span>
               <button type="button" class="chat-btn" id="overview_refresh">Refresh</button>
            </div>

            <div class="home-stats" aria-label="At a glance">
               <div class="home-stat">
                  <span class="home-stat-label">Node</span>
                  <span class="home-stat-value"><span class="home-state-dot"></span><span id="stat_node"></span></span>
                  <span class="home-stat-note">Unlocked &middot; identity set up</span>
               </div>
               <div class="home-stat">
                  <span class="home-stat-label">Up for</span>
                  <span class="home-stat-value" id="stat_uptime">&hellip;</span>
                  <span class="home-stat-note">Since the last restart</span>
               </div>
               <div class="home-stat">
                  <span class="home-stat-label">People</span>
                  <span class="home-stat-value"><span id="stat_people">&hellip;</span> <span class="home-stat-unit">active</span></span>
                  <span class="home-stat-note" id="stat_people_note"></span>
               </div>
               <div class="home-stat">
                  <span class="home-stat-label">Sessions</span>
                  <span class="home-stat-value"><span class="home-stat-unit">up to</span> 100</span>
                  <span class="home-stat-note">How many are in use is not reported yet</span>
               </div>
            </div>

            <div class="home-columns">
               <div class="home-column-main">
                  <section class="home-card home-card--row" aria-label="Connection security">
                     <span class="home-tile-icon" id="connection_icon"></span>
                     <span class="home-card-body">
                        <h2 id="connection_heading"></h2>
                        <span class="home-mono home-cipher" id="connection_cipher"></span>
                        <span class="home-note home-empty">As the node sees this browser's connection. Behind a proxy it sees
                         the proxy's instead.</span>
                     </span>
                  </section>

                  <section class="home-card home-card--row home-card--warn" aria-label="Unlock keys">
                     <span class="home-tile-icon is-warn" id="keys_icon"></span>
                     <span class="home-card-body">
                        <h2>Keep a few unlock keys</h2>
                        <span class="home-note home-empty" id="overview_keys_note"></span>
                     </span>
                     <a href="#keys" class="chat-btn chat-btn--primary home-card-action" id="overview_make_key">Make a key</a>
                  </section>

                  <section class="home-card" aria-label="The server log">
                     <div class="home-card-head">
                        <h2>Latest from the server log</h2>
                        <a href="#logs" class="home-link" id="overview_open_logs">Open Logs</a>
                     </div>
                     <pre class="home-log home-log--short" id="overview_log"></pre>
                  </section>
               </div>

               <div class="home-column-side">
                  <section class="home-card" aria-label="People">
                     <h2>People</h2>
                     <p class="home-note home-empty" id="overview_people"></p>
                     <div class="home-card-actions">
                        <a href="#" class="chat-btn" id="overview_add_person">Add a person</a>
                        <a href="#" class="chat-btn" id="overview_people_link">People</a>
                     </div>
                  </section>
               </div>
            </div>
         </section>

         <!-- NOTE: Unlock keys - made by admin while the node is unlocked, each shown once and used once. The node
              cannot list them, so Home counts the ones made on this browser (the design's known limit). -->
         <section class="home-section" id="section_keys" hidden>
            <h1>Unlock keys</h1>
            <p class="home-note">A key unlocks the node after a restart without the master password - from anywhere, by
             anyone who has it. Each works once. Keep a few somewhere safe: a password manager, or written down.</p>

            <section class="home-card home-keys-card">
               <p class="home-note home-empty" id="keys_note"></p>
               <div class="home-card-actions">
                  <button type="button" class="chat-btn chat-btn--primary" id="key_make">Make a key</button>
               </div>
               <div class="chat-error-text" id="key_error" role="alert"></div>

               <div class="home-new-key" id="key_shown" hidden>
                  <span class="home-rail-heading">Your new key - shown once</span>
                  <div class="home-new-key-row">
                     <span class="home-key-qr" id="key_qr" aria-hidden="true"></span>
                     <span class="home-new-key-text">
                        <span class="home-key" id="key_text"></span>
                        <span class="home-note home-empty">Store it now - it cannot be shown again. A phone can scan the
                         code into a password manager.</span>
                        <span class="home-card-actions">
                           <button type="button" class="chat-btn" id="key_copy">Copy</button>
                           <button type="button" class="chat-btn chat-btn--primary" id="key_stored">I've stored it</button>
                        </span>
                     </span>
                  </div>
               </div>
            </section>
         </section>

         <!-- NOTE: The node's logs, read only - admin's (Ian, 2026-10-03). The newest at the end, as in the file. -->
         <section class="home-section" id="section_logs" hidden>
            <div class="home-section-head">
               <h1>Logs</h1>
               <button type="button" class="chat-btn" id="logs_refresh">Refresh</button>
            </div>

            <div class="home-log-bar">
               <div class="home-log-tabs" id="log_tabs" role="tablist" aria-label="Logs"></div>
               <input type="search" class="chat-field home-log-filter" id="log_filter" placeholder="Filter" aria-label="Filter the log">
               <select class="chat-field home-log-count" id="log_count" aria-label="How many lines">
                  <option value="100">Last 100 lines</option>
                  <option value="200" selected>Last 200 lines</option>
                  <option value="1000">Last 1000 lines</option>
                  <option value="0">Every line</option>
               </select>
            </div>
            <p class="home-note" id="log_status" role="status"></p>
            <pre class="home-log" id="log_lines"></pre>
         </section>
      </main>

      <nav class="home-bottombar" id="home_bottombar" aria-label="Apps"></nav>
   </div>
</div>
