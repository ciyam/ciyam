<!-- ================================================================ linking - opened from the chat, waiting for its session -->
<div class="chat-signin" id="linking_view" hidden>
   <div class="chat-signin-form">
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">accounts</span>
      </div>

      <h2 tabindex="-1">Accounts</h2>
      <p class="chat-signin-lede" id="linking_text" role="status">Using the chat's session...</p>

      <div class="chat-signin-actions" id="linking_actions" hidden>
         <button type="button" class="chat-btn chat-btn--primary" onclick="do_sign_in_instead( )">Sign in here instead</button>
      </div>
   </div>
</div>

<!-- ================================================================ sign in -->
<!-- NOTE: The node's sign in, shared by every app - built here by "signin.js". -->
<div id="signin_host"></div>

<div class="chat-signin" id="welcome_view" hidden>
   <form class="chat-signin-form" onsubmit="do_join( event )" novalidate>
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">accounts</span>
      </div>

      <h2 tabindex="-1">Welcome</h2>
      <p class="chat-signin-lede">Use what you were given to set up your account.</p>

      <div class="account-tabs" role="tablist" aria-label="What you were given">
         <button type="button" role="tab" id="join_tab_code" aria-selected="true" onclick="set_join_mode( 'code' )">I have a code</button>
         <button type="button" role="tab" id="join_tab_pin" aria-selected="false" onclick="set_join_mode( 'pin' )">I have a PIN</button>
      </div>

      <div class="account-stack" id="join_code_row">
         <label class="chat-label" for="join_code">Code</label>
         <input type="text" id="join_code" class="chat-field chat-field--mono account-code-field" autocomplete="off"
          autocapitalize="none" spellcheck="false" placeholder="abc-defg-hij" oninput="on_join_code_input( )">
         <div class="account-hint">From the person who added you - scanning their QR code fills it in.</div>
      </div>

      <div class="account-stack" id="join_pin_row" hidden>
         <label class="chat-label" for="join_pin">PIN</label>
         <div class="account-inline">
            <input type="text" id="join_pin" class="chat-field chat-field--mono" inputmode="numeric" maxlength="5"
             autocomplete="off" oninput="on_join_pin_input( )">
            <button type="button" class="chat-btn account-inline-btn" id="join_pin_check" onclick="do_check_pin( )">Continue</button>
         </div>
      </div>

      <div class="account-stack" id="join_details">
         <label class="chat-label" for="join_username">Choose a username</label>
         <input type="text" id="join_username" class="chat-field" autocomplete="username" autocapitalize="none"
          spellcheck="false" maxlength="12">
         <div class="account-hint" id="join_username_hint"></div>

         <label class="chat-label" for="join_password">Choose a password</label>
         <input type="password" id="join_password" class="chat-field" autocomplete="new-password" oninput="update_strength( 'join' )">
         <div class="chat-strength" id="join_strength" hidden>
            <div class="chat-strength-track"><div class="chat-strength-bar"></div></div>
            <span class="chat-strength-label" id="join_strength_label"></span>
         </div>

         <button type="button" class="chat-btn chat-btn--link chat-suggest" id="join_suggest"
          onclick="offer_passphrase( 'join_password', 'join_confirm', 'join_suggested' )">Suggest one</button>
         <p class="chat-hint chat-suggested" id="join_suggested" role="status" hidden></p>
         <label class="chat-label" for="join_confirm">Type it again</label>
         <input type="password" id="join_confirm" class="chat-field" autocomplete="new-password">

         <!-- NOTE: As on the sign in - you are signed in once the account is made (Damon, 2026-10-05). -->
         <label class="chat-label" for="join_retain">Remember on this browser</label>
         <select id="join_retain" class="chat-field">
            <option value="none">Nothing &mdash; forget this account</option>
            <option value="access">The PIN only</option>
            <option value="full">The PIN and the password</option>
         </select>
         <div class="account-hint">You're signed in once your account is made. Saving the password as well signs you in
          without typing it next time.</div>
      </div>

      <div class="chat-error-text" id="join_error" role="alert"></div>

      <div class="chat-signin-busy" id="join_busy" hidden><span class="chat-spinner"></span><span id="join_busy_text" role="status"></span></div>
      <progress class="chat-signin-progress" id="join_busy_bar" max="1" value="0" hidden></progress>

      <div class="chat-signin-actions">
         <button type="submit" class="chat-btn chat-btn--primary" id="join_submit">Create my account</button>
      </div>

      <p class="account-aside">Already set up? <a href="#">Sign in</a></p>
   </form>
</div>

<!-- ================================================================ write these down -->
<div class="chat-signin" id="written_view" hidden>
   <div class="chat-signin-form">
      <div class="chat-brand">
         <span class="chat-logo"></span>
         <span class="chat-wordmark">CIYAM</span>
         <span class="chat-brand-note">accounts</span>
      </div>

      <span class="account-tick" aria-hidden="true">
         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </span>

      <h2 tabindex="-1">You're in. Write these down.</h2>
      <p class="chat-signin-lede">On a new phone or computer you'll need all three: your PIN, your username and your password.</p>

      <div class="account-facts">
         <div class="account-fact">
            <span class="chat-label">Your PIN</span>
            <span class="chat-mono account-fact-big" id="written_pin"></span>
         </div>
         <div class="account-fact">
            <span class="chat-label">Your username</span>
            <span class="account-fact-name" id="written_username"></span>
         </div>
      </div>

      <p class="account-note">Keep a hint for your password with them - never the password itself. If you forget it, ask the person who added you.</p>

      <label class="account-check">
         <input type="checkbox" id="written_check" onchange="update_written( )">
         I've written my PIN and username down
      </label>

      <div class="chat-signin-actions">
         <button type="button" class="chat-btn chat-btn--primary" id="written_open" onclick="do_open_chat( )" disabled>Open the chat</button>
      </div>
   </div>
</div>

<!-- ================================================================ signed in -->
<div class="account-app" id="app_view" hidden>
   <header class="account-topbar">
      <!-- NOTE: The app switcher - the CIYAM mark and "Accounts" (or "My account"), as at the top of every app
           ("apps.js", 2026-10-08). It replaced "Chat" - "Back to the chat" when linked - and Sign out here. -->
      <div id="apps_host"></div>

      <span class="account-spacer"></span>

      <span class="account-who-am-i" id="topbar_user"></span>

      <button type="button" class="chat-btn chat-btn--mono" id="console_toggle" onclick="do_toggle_console( )">Console</button>
   </header>

   <main class="account-main">
      <div class="account-alert" id="account_alert" role="status" hidden></div>

      <!-- ------------------------------------------------------------ My account -->
      <section class="account-section" id="mine_section" hidden>
         <h1 tabindex="-1">My account</h1>

         <div class="account-card account-identity">
            <span class="account-avatar account-avatar--large" id="mine_avatar"></span>
            <div>
               <div class="account-identity-name" id="mine_name"></div>
               <div class="account-identity-meta"><span id="mine_type"></span></div>
            </div>
         </div>

         <!-- NOTE: This account's devices (Ian, 2026-10-06) - "GET /cws/devices". Rows are made in "render_devices( )". -->
         <div class="account-card account-form" id="mine_devices">
            <div>
               <h2>Devices</h2>
               <p class="account-lede">Each browser this account has signed in from. Remove one you've lost - it's signed out, and
                has to sign in again.</p>
            </div>

            <ul class="account-devices" id="mine_devices_list"></ul>

            <div class="chat-error-text" id="mine_devices_error" role="alert"></div>
         </div>

         <!-- NOTE: Your keys (Ian, 2026-10-23 and 2026-10-25) - for encrypted messages, from twelve words of the account's own,
              locked under them before they go to the node ("user-keys"). One part shown at a time, by "keys_show( )" in
              "account_keys.js". -->
         <div class="account-card account-form" id="mine_keys">
            <div>
               <h2>Your keys</h2>
               <p class="account-lede" id="keys_lede">For encrypted messages - only the people you write to can read them.</p>
            </div>

            <div class="account-keys-part" id="keys_loading" role="status">Looking for your keys…</div>

            <div class="account-keys-part" id="keys_none" hidden>
               <p class="account-lede">Your keys come from twelve words of your own, which you write down. The node never sees
                them - it keeps only what they lock.</p>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_start">Set up your keys</button>
               </div>
            </div>

            <div class="account-keys-part" id="keys_random" hidden>
               <p class="account-lede">Pop any twelve bubbles as they rise. When and where you catch them is mixed with this
                browser's own randomness to make your words.</p>
               <div class="home-bubbles" id="keys_bubbles" role="group" aria-label="Bubbles to pop"></div>
               <div class="home-setup-count">
                  <span id="keys_popped">0 of 12 popped</span>
                  <span>The browser adds its own randomness too</span>
               </div>
               <div class="home-setup-meter" aria-hidden="true"><span id="keys_popped_bar"></span></div>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn" id="keys_random_cancel">Cancel</button>
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_random_next" disabled>Next</button>
               </div>
            </div>

            <div class="account-keys-part" id="keys_words" hidden>
               <p class="account-lede">Write down your twelve words, on paper, in order. You type them on each browser you use
                your keys on, and they are the only way to get your keys back.</p>
               <ol class="home-setup-words" id="keys_word_list"></ol>
               <div class="recover-warning"><b>Shown only now.</b> Not a screenshot, not a file on this computer, not a photo.
                Anyone who has them can read your encrypted messages.</div>
               <label class="home-setup-tick">
                  <input type="checkbox" id="keys_written">
                  <span>I've written all twelve down, in order</span>
               </label>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn" id="keys_words_cancel">Cancel</button>
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_words_next" disabled>Check them</button>
               </div>
            </div>

            <div class="account-keys-part" id="keys_check" hidden>
               <p class="account-lede">From your paper, not from memory: for each word, pick the one you wrote.</p>
               <div class="home-setup-check" id="keys_check_rows"></div>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn" id="keys_check_back">See the words again</button>
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_save" disabled>Save your keys</button>
               </div>
            </div>

            <div class="account-keys-part" id="keys_enter" hidden>
               <p class="account-lede" id="keys_enter_lede">Your keys are set up. To use them on this browser, type your
                twelve words.</p>
               <label class="chat-label" for="keys_enter_words">Your twelve words</label>
               <textarea class="chat-field account-keys-words" id="keys_enter_words" rows="3" autocomplete="off" autocapitalize="off"
                spellcheck="false"></textarea>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn" id="keys_enter_new">Start again with new words</button>
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_enter_go">Use my keys here</button>
               </div>
            </div>

            <div class="account-keys-part" id="keys_here" hidden>
               <p class="account-lede" id="keys_here_lede">Your keys are on this browser.</p>
               <div class="account-keys-public">
                  <div class="account-keys-qr" id="keys_qr" aria-hidden="true"></div>
                  <div>
                     <div class="chat-label">Your public key</div>
                     <p class="account-lede">Others scan or copy this to write to you. It's safe to share.</p>
                     <code class="account-keys-key" id="keys_public"></code>
                  </div>
               </div>
               <p class="account-lede" id="keys_contacts"></p>
               <div class="account-actions-row">
                  <button type="button" class="chat-btn" id="keys_forget">Forget them on this browser</button>
                  <button type="button" class="chat-btn chat-btn--primary" id="keys_save_again" hidden>Save them on the node</button>
               </div>
            </div>

            <div class="chat-error-text" id="keys_error" role="alert"></div>
            <div class="chat-signin-busy" id="keys_busy" hidden><span class="chat-spinner"></span><span id="keys_busy_text" role="status"></span></div>
         </div>

         <!-- NOTE: Desktop notifications from the chat (Damon, 2026-10-20) - the same switch as in the chat's account menu
              ("notify.js"); here so that, as more kinds come, they are set in one place. -->
         <div class="account-card account-form" id="mine_notify">
            <div>
               <h2>Notifications</h2>
               <p class="account-lede">A notification on this computer when a message arrives and the chat is open in the
                background - who and where, never what was said. Kept for this account on this browser.</p>
            </div>

            <label class="account-check">
               <input type="checkbox" id="mine_notify_switch" onchange="do_mine_notify( this.checked )">
               Desktop notifications from the chat
            </label>

            <p class="account-lede" id="mine_notify_status" aria-live="polite"></p>
         </div>

         <form class="account-card account-form" id="mine_password_form" onsubmit="do_change_password( event )" novalidate>
            <div>
               <h2>Change password</h2>
               <p class="account-lede">You stay signed in here. Other devices will need the new password.</p>
            </div>

            <input type="text" id="mine_username" class="account-sr" autocomplete="username" tabindex="-1" aria-hidden="true" readonly>

            <div>
               <label class="chat-label" for="mine_current">Current password</label>
               <input type="password" id="mine_current" class="chat-field" autocomplete="current-password">
            </div>

            <div>
               <label class="chat-label" for="mine_password">New password</label>
               <input type="password" id="mine_password" class="chat-field" autocomplete="new-password" oninput="update_strength( 'mine' )">
               <div class="chat-strength" id="mine_strength" hidden>
                  <div class="chat-strength-track"><div class="chat-strength-bar"></div></div>
                  <span class="chat-strength-label" id="mine_strength_label"></span>
               </div>
            </div>

            <div>
               <button type="button" class="chat-btn chat-btn--link chat-suggest" id="mine_suggest"
                onclick="offer_passphrase( 'mine_password', 'mine_confirm', 'mine_suggested' )">Suggest one</button>
               <p class="chat-hint chat-suggested" id="mine_suggested" role="status" hidden></p>
               <label class="chat-label" for="mine_confirm">Type it again</label>
               <input type="password" id="mine_confirm" class="chat-field" autocomplete="new-password">
            </div>

            <div class="chat-error-text" id="mine_error" role="alert"></div>

            <div class="chat-signin-busy" id="mine_busy" hidden><span class="chat-spinner"></span><span id="mine_busy_text" role="status"></span></div>
            <progress class="chat-signin-progress" id="mine_busy_bar" max="1" value="0" hidden></progress>

            <div class="account-actions-row">
               <button type="submit" class="chat-btn chat-btn--primary" id="mine_submit">Change password</button>
            </div>
         </form>

         <div class="account-card account-form" id="mine_admin_note" hidden>
            <h2>Password</h2>
            <p class="account-lede">admin's password is also the node's master password - the one that unlocks the node after a
             restart - so it isn't changed here.</p>
         </div>
      </section>
   </main>
</div>

<!-- ================================================================ the console drawer - as in the chat, handed this page's session -->
<div id="console_drawer" class="chat-console" hidden>
   <div class="chat-console-bar">
      <span class="chat-console-label">Console</span>
      <span class="chat-console-session">
         <span class="chat-dot"></span>
         <span id="console_session"></span>
      </span>
      <button type="button" class="chat-console-close" onclick="do_popout_console( )"
       aria-label="Open the console in its own window" title="Open in its own window">&#8599;</button>
      <button type="button" class="chat-console-close" onclick="do_toggle_console( )" aria-label="Close console">&times;</button>
   </div>
</div>

